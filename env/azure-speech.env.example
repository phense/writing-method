# env/azure-speech.env — Azure AI Speech (text to speech)
# Used by: tools/voice_azure.py and tools/probe_settings.py in a video project
# Copy this file to env/azure-speech.env and fill in the values.
# The real file is ignored by Git. Never commit it, never paste a key into a command.
#
# Key: Azure portal -> your Speech resource -> Keys and Endpoint -> KEY 1
AZURE_SPEECH_KEY=
# Region of the resource, for example westeurope
AZURE_SPEECH_REGION=
