# env/elevenlabs.env — ElevenLabs settings (no secret)
# ElevenLabs is reached through its connector in the assistant session.
# This method stores NO ElevenLabs key: authorize the connector in your
# assistant instead. The values below are non-secret choices that you may
# keep here or in the video profile (speech.voice, speech.model, speech.tone).
#
# Voice identifier from the connector's voice list (never invent one)
ELEVENLABS_VOICE_ID=
# Model; it must speak the target language and English
ELEVENLABS_MODEL=
# Optional: one mild tone tag for the start of a scene passage, for example [warm]
ELEVENLABS_TONE=
