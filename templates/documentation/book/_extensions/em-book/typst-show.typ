#show: body => em-book(
  title: [$title$],
  subtitle: [$if(subtitle)$$subtitle$$endif$],
  lang: "$if(lang)$$lang$$else$en$endif$",
  kind: [$if(document-kind)$$document-kind$$endif$],
  part-label: "$if(part-label)$$part-label$$endif$",
  accent: brand-color.at("primary", default: rgb("173A5E")),
  ink: brand-color.at("foreground", default: rgb("232A31")),
  muted: brand-color.at("muted", default: rgb("5B6670")),
  font: $if(brand.typography.base.family)$$brand.typography.base.family$$else$("Source Sans 3",)$endif$,
  font-size: $if(brand.typography.base.size)$$brand.typography.base.size$$else$11pt$endif$,
  code-font: $if(brand.typography.monospace.family)$$brand.typography.monospace.family$$else$("DejaVu Sans Mono",)$endif$,
  code-size: $if(brand.typography.monospace.size)$$brand.typography.monospace.size$$else$9.5pt$endif$,
  show-toc: $if(toc)$true$else$false$endif$,
  toc-title: [$if(toc-title)$$toc-title$$endif$],
  imprint-version: [$if(imprint.version)$$imprint.version$$endif$],
  imprint-date: "$if(imprint.date)$$imprint.date$$endif$",
  imprint-organisation: ($for(imprint.organisation)$[$it$], $endfor$),
  imprint-author: ($for(imprint.author)$[$it$], $endfor$),
  numbering-pattern: $if(section-numbering)$"$section-numbering$"$else$none$endif$,
  body,
)
